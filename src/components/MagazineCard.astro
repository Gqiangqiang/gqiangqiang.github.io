---
/**
 * 杂志式文章卡片
 * 不对称布局、艺术感排版
 */
interface Props {
  title: string;
  description: string;
  date: string;
  slug: string;
  tags?: string[];
  readingTime?: string;
  featured?: boolean;
  layout?: 'default' | 'wide' | 'tall';
  index?: number;
  basePath?: string;
}

const {
  title,
  description,
  date,
  slug,
  tags = [],
  readingTime = '5 分钟',
  featured = false,
  layout = 'default',
  index = 0,
  basePath = '/blog'
} = Astro.props;

// 转换 slug: 移除路径前缀和 .md 扩展名
const articleSlug = slug.replace(/^.*\//, '').replace(/\.md$/, '');

const formattedDate = new Date(date).toLocaleDateString('zh-CN', {
  month: 'short',
  day: 'numeric',
});

const year = new Date(date).getFullYear();
---

<article
  class:list={['article-card', layout, { featured }]}
  style={`--index: ${index}`}
>
  <a href={`${basePath}/${articleSlug}`} class="card-link">
    <!-- 序号 -->
    <span class="card-number">{String(index + 1).padStart(2, '0')}</span>

    <!-- 日期标签 -->
    <div class="card-date">
      <span class="date-day">{formattedDate}</span>
      <span class="date-year">{year}</span>
    </div>

    <!-- 内容 -->
    <div class="card-body">
      <h3 class="card-title">{title}</h3>
      <p class="card-desc">{description}</p>
    </div>

    <!-- 元信息 -->
    <div class="card-meta">
      <span class="meta-time">{readingTime}</span>
      {tags.length > 0 && (
        <span class="meta-tag">{tags[0]}</span>
      )}
    </div>

    <!-- 悬停指示 -->
    <div class="card-arrow">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M7 17L17 7M17 7H7M17 7V17"/>
      </svg>
    </div>

    <!-- 特色标记 -->
    {featured && (
      <div class="featured-mark">
        <span>Featured</span>
      </div>
    )}
  </a>
</article>

<style>
  .article-card {
    position: relative;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    overflow: hidden;
    opacity: 0;
    transform: translateY(30px);
    animation: cardReveal 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(var(--index) * 80ms + 200ms);
  }

  @keyframes cardReveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* 布局变体 */
  .article-card.wide {
    grid-column: span 2;
  }

  .article-card.tall {
    grid-row: span 2;
  }

  .article-card.featured {
    background: linear-gradient(
      135deg,
      var(--color-bg-secondary),
      var(--color-gradient-start)
    );
    border-color: var(--color-accent-muted);
  }

  .card-link {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--space-4);
    height: 100%;
    padding: var(--space-6);
    text-decoration: none;
    color: inherit;
    position: relative;
    transition: all var(--transition-base);
  }

  .article-card:hover {
    border-color: var(--color-border);
    transform: translateY(-4px);
    box-shadow: var(--shadow-xl);
  }

  /* 序号 */
  .card-number {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    opacity: 0.4;
    letter-spacing: 0.1em;
  }

  /* featured 卡片隐藏序号 */
  .article-card.featured .card-number {
    display: none;
  }

  /* 日期 */
  .card-date {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .date-day {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .date-year {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    opacity: 0.6;
  }

  /* 内容 */
  .card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .card-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-text-primary);
    line-height: var(--leading-snug);
    margin: 0;
    transition: color var(--transition-fast);
  }

  .article-card:hover .card-title {
    color: var(--color-accent);
  }

  .card-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* 元信息 */
  .card-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }

  .meta-time {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .meta-tag {
    padding: var(--space-1) var(--space-2);
    background: var(--color-bg-tertiary);
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
  }

  .article-card:hover .meta-tag {
    background: var(--color-accent-light);
    color: var(--color-accent);
  }

  /* 箭头 */
  .card-arrow {
    position: absolute;
    bottom: var(--space-6);
    right: var(--space-6);
    width: 24px;
    height: 24px;
    color: var(--color-text-tertiary);
    opacity: 0;
    transform: translate(-10px, 10px);
    transition: all var(--transition-base);
  }

  .article-card:hover .card-arrow {
    opacity: 1;
    transform: translate(0, 0);
    color: var(--color-accent);
  }

  /* 特色标记 */
  .featured-mark {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    padding: var(--space-1) var(--space-3);
    background: var(--color-accent);
    color: white;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: var(--radius-sm);
  }

  /* 响应式 */
  @media (max-width: 768px) {
    .article-card.wide,
    .article-card.tall {
      grid-column: span 1;
      grid-row: span 1;
    }

    .card-link {
      padding: var(--space-5);
    }

    .card-title {
      font-size: var(--text-lg);
    }
  }
</style>
