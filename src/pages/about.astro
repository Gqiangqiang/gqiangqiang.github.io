---
/**
 * 关于页面
 */
import LayoutImmersive from '../layouts/LayoutImmersive.astro';
import { siteConfig } from '../config';

const socialLinks = Object.values(siteConfig.social);
---

<LayoutImmersive title={`关于 · ${siteConfig.name}`} currentPath="/about">
  <div class="about-page">
    <!-- 头部区域 -->
    <header class="about-header">
      <div class="avatar-wrapper">
        <div class="avatar-placeholder">
          <span>{siteConfig.author.name[0]}</span>
        </div>
      </div>
      <div class="header-content">
        <span class="header-label">About</span>
        <h1 class="header-title">{siteConfig.author.name}</h1>
        <p class="header-subtitle">{siteConfig.author.bio}</p>
      </div>
    </header>

    <!-- 介绍区域 -->
    <section class="about-section">
      <div class="section-container">
        <div class="section-header">
          <span class="section-number">01</span>
          <h2 class="section-title">关于我</h2>
        </div>
        <div class="section-content">
          <p>
            我是一名热爱技术的前端开发者，专注于构建优雅、高效的 Web 应用。
            我相信代码不仅是工具，更是一种艺术表达形式。
          </p>
          <p>
            在这个博客里，我会分享技术心得、学习笔记、生活感悟。
            希望我的文字能给你带来一些启发或帮助。
          </p>
          <p>
            工作之余，我喜欢阅读、写作、摄影。
            相信持续学习是保持创造力的关键。
          </p>
        </div>
      </div>
    </section>

    <!-- 联系方式 -->
    <section class="about-section">
      <div class="section-container">
        <div class="section-header">
          <span class="section-number">02</span>
          <h2 class="section-title">联系我</h2>
        </div>
        <div class="social-grid">
          {socialLinks.map((link, index) => (
            <a
              href={link.url}
              class="social-card"
              target="_blank"
              rel="noopener noreferrer"
              style={`--delay: ${index * 100}ms`}
            >
              {link.icon === 'github' && (
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
              )}
              {link.icon === 'twitter' && (
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              )}
              {link.icon === 'linkedin' && (
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              )}
              {link.icon === 'email' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="2" y="4" width="20" height="16" rx="2"/>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                </svg>
              )}
              <span class="social-name">{link.name}</span>
              <span class="social-arrow">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16">
                  <path d="M7 17L17 7M17 7H7M17 7V17"/>
                </svg>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 座右铭 -->
    <div class="motto-section">
      <blockquote class="motto">
        <p>{siteConfig.author.signature}</p>
        <p>在技术的海洋中，用热爱书写每一行代码。</p>
      </blockquote>
    </div>
  </div>
</LayoutImmersive>

<style>
  .about-page {
    min-height: 100vh;
  }

  /* 头部 */
  .about-header {
    padding: var(--space-16) var(--space-8);
    text-align: center;
  }

  .avatar-wrapper {
    margin-bottom: var(--space-6);
  }

  .avatar-placeholder {
    width: 120px;
    height: 120px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-accent-600), var(--color-accent));
    border-radius: 50%;
    box-shadow: var(--shadow-xl);
  }

  .avatar-placeholder span {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 700;
    color: white;
  }

  .header-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }

  .header-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .header-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 8vw, 4rem);
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
    letter-spacing: -0.02em;
  }

  .header-subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
  }

  /* 区域 */
  .about-section {
    padding: 0 var(--space-8) var(--space-12);
  }

  .section-container {
    max-width: 700px;
    margin: 0 auto;
  }

  .section-header {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .section-number {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-accent);
    opacity: 0.5;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-text-primary);
    margin: 0;
  }

  .section-content {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  .section-content p {
    margin-bottom: var(--space-4);
  }

  /* 技能 */
  .skills-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .skill-item {
    opacity: 0;
    animation: fadeInUp 0.5s ease forwards;
    animation-delay: var(--delay);
  }

  .skill-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: var(--space-2);
  }

  .skill-name {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-primary);
  }

  .skill-level {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }

  .skill-bar {
    height: 4px;
    background: var(--color-bg-tertiary);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .skill-progress {
    height: 100%;
    width: var(--progress);
    background: var(--color-accent);
    border-radius: var(--radius-full);
    animation: progressFill 1s ease forwards;
    animation-delay: var(--delay);
  }

  @keyframes progressFill {
    from { width: 0; }
  }

  /* 社交链接 */
  .social-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }

  .social-card {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all var(--transition-base);
    opacity: 0;
    animation: fadeInUp 0.5s ease forwards;
    animation-delay: var(--delay);
  }

  .social-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .social-card svg {
    width: 20px;
    height: 20px;
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
  }

  .social-card:hover svg {
    color: var(--color-accent);
  }

  .social-name {
    flex: 1;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-primary);
  }

  .social-arrow {
    color: var(--color-text-tertiary);
    opacity: 0;
    transform: translateX(-10px);
    transition: all var(--transition-fast);
  }

  .social-card:hover .social-arrow {
    opacity: 1;
    transform: translateX(0);
    color: var(--color-accent);
  }

  /* 座右铭 */
  .motto-section {
    padding: var(--space-12) var(--space-8) var(--space-16);
  }

  .motto {
    max-width: 600px;
    margin: 0 auto;
    padding: var(--space-8);
    background: linear-gradient(135deg, var(--color-gradient-start), var(--color-gradient-end));
    border-radius: var(--radius-xl);
    text-align: center;
    border: none;
  }

  .motto p {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--color-text-primary);
    margin-bottom: var(--space-2);
    font-style: italic;
  }

  .motto p:last-child {
    margin-bottom: 0;
    font-size: var(--text-base);
    color: var(--color-text-secondary);
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 640px) {
    .about-header {
      padding: var(--space-12) var(--space-4);
    }

    .about-section {
      padding: 0 var(--space-4) var(--space-10);
    }

    .social-grid {
      grid-template-columns: 1fr;
    }

    .motto-section {
      padding: var(--space-8) var(--space-4) var(--space-12);
    }
  }
</style>
