---
/**
 * 阅读页面
 * 展示书单、阅读笔记、正在阅读的书籍
 */
import LayoutImmersive from '../../layouts/LayoutImmersive.astro';
import PageHeader from '../../components/PageHeader.astro';
import { siteConfig } from '../../config';
import { getCollection } from 'astro:content';

// 获取所有书籍数据
const allBooks = await getCollection('reading');

// 正在阅读的书籍
const currentlyReading = allBooks
  .filter(book => book.data.status === 'reading')
  .map(book => ({
    id: book.id,
    title: book.data.title,
    author: book.data.author,
    cover: book.data.cover,
    progress: book.data.progress,
    category: book.data.category,
  }));

// 有笔记的书籍
const booksWithNotes = allBooks
  .filter(book => book.data.hasNotes)
  .map(book => ({
    id: book.id,
    title: book.data.title,
    author: book.data.author,
    cover: book.data.cover,
    category: book.data.category,
  }));

// 书架数据（按出版日期倒序，最多显示10条）
const bookshelf = allBooks
  .sort((a, b) => {
    const dateA = a.data.publishDate?.getTime() || 0;
    const dateB = b.data.publishDate?.getTime() || 0;
    return dateB - dateA;
  })
  .slice(0, 10)
  .map(book => ({
    id: book.id,
    title: book.data.title,
    author: book.data.author,
    cover: book.data.cover,
    rating: book.data.rating,
    category: book.data.category,
    year: book.data.publishDate?.getFullYear(),
  }));

// 统计数据
const finishedBooks = allBooks.filter(book => book.data.status === 'finished');
const stats = {
  totalBooks: allBooks.length,
  thisYear: finishedBooks.filter(b => b.data.date && b.data.date.getFullYear() === new Date().getFullYear()).length,
  pages: finishedBooks.length * 350, // 估算每本书350页
  hours: finishedBooks.length * 20,  // 估算每本书20小时
};
---

<LayoutImmersive title={`阅读 · ${siteConfig.name}`} currentPath="/reading">
  <div class="reading-page">
    <!-- 页面头部 -->
    <PageHeader
      label="Reading"
      title="阅读"
      description="书籍是人类进步的阶梯"
    />

    <!-- 统计数据 -->
    <section class="stats-section">
      <div class="stats-container">
        <div class="stats-grid">
          <div class="stat-item">
            <span class="stat-value">{stats.totalBooks}</span>
            <span class="stat-label">累计阅读</span>
          </div>
          <div class="stat-item">
            <span class="stat-value">{stats.thisYear}</span>
            <span class="stat-label">今年已读</span>
          </div>
          <div class="stat-item">
            <span class="stat-value">{stats.pages.toLocaleString()}</span>
            <span class="stat-label">阅读页数</span>
          </div>
          <div class="stat-item">
            <span class="stat-value">{stats.hours}</span>
            <span class="stat-label">阅读时长</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 正在阅读 -->
    <section class="current-section">
      <div class="section-container">
        <div class="section-header">
          <span class="section-number">01</span>
          <h2 class="section-title">正在阅读</h2>
        </div>
        <div class="reading-grid">
          {currentlyReading.map((book, i) => (
            <a href={`/reading/${book.id}`} class="reading-card" style={`--delay: ${i * 100}ms`}>
              <div class="book-cover">
                <img src={book.cover} alt={book.title} />
                <div class="progress-overlay">
                  <div class="progress-bar" style={`--progress: ${book.progress}%`}></div>
                </div>
              </div>
              <div class="book-info">
                <span class="book-category">{book.category}</span>
                <h3 class="book-title">{book.title}</h3>
                <p class="book-author">{book.author}</p>
                <div class="reading-progress">
                  <span class="progress-text">{book.progress}% 已读</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 书架 -->
    <section class="bookshelf-section">
      <div class="section-container">
        <div class="section-header">
          <span class="section-number">02</span>
          <h2 class="section-title">书架</h2>
          <div class="filter-tabs">
            <button class="filter-tab active" data-filter="all">全部</button>
            <button class="filter-tab" data-filter="技术">技术</button>
            <button class="filter-tab" data-filter="设计">设计</button>
            <button class="filter-tab" data-filter="其他">其他</button>
          </div>
        </div>
        <div class="bookshelf-grid">
          {bookshelf.map((book, i) => (
            <a href={`/reading/${book.id}`} class="bookshelf-card" style={`--delay: ${i * 80}ms`} data-category={book.category}>
              <div class="book-cover">
                <img src={book.cover} alt={book.title} />
              </div>
              <div class="book-info">
                <span class="book-year">{book.year}</span>
                <h3 class="book-title">{book.title}</h3>
                <p class="book-author">{book.author}</p>
                <div class="book-rating">
                  {Array.from({ length: 5 }).map((_, idx) => (
                    <span class:list={['star', { filled: idx < book.rating }]}>★</span>
                  ))}
                </div>
              </div>
            </a>
          ))}
        </div>
        <div class="view-more">
          <a href="/reading/bookshelf" class="view-more-link">
            查看完整书架
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16">
              <path d="M7 17L17 7M17 7H7M17 7V17"/>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- 阅读笔记 -->
    <section class="notes-section">
      <div class="section-container">
        <div class="section-header">
          <span class="section-number">03</span>
          <h2 class="section-title">阅读笔记</h2>
          <a href="/reading/notes" class="view-all">
            查看全部
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16">
              <path d="M7 17L17 7M17 7H7M17 7V17"/>
            </svg>
          </a>
        </div>
        <div class="notes-list">
          {booksWithNotes.length > 0 ? (
            booksWithNotes.map((book, i) => (
              <a href={`/reading/${book.id}`} class="note-card" style={`--delay: ${i * 100}ms`}>
                <div class="note-content">
                  <span class="note-book">《{book.title}》</span>
                  <h3 class="note-title">{book.title} 读书笔记</h3>
                  <p class="note-excerpt">点击查看这本书的阅读笔记</p>
                </div>
                <div class="note-meta">
                  <span class="note-arrow">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16">
                      <path d="M7 17L17 7M17 7H7M17 7V17"/>
                    </svg>
                  </span>
                </div>
              </a>
            ))
          ) : (
            <p class="empty-state">暂无阅读笔记</p>
          )}
        </div>
      </div>
    </section>
  </div>
</LayoutImmersive>

<style>
  .reading-page {
    min-height: 100vh;
  }

  /* 统计数据 */
  .stats-section {
    padding: 0 var(--space-8) var(--space-12);
  }

  .stats-container {
    max-width: 800px;
    margin: 0 auto;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
  }

  .stat-item {
    text-align: center;
    padding: var(--space-5);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
  }

  .stat-value {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1;
    margin-bottom: var(--space-2);
  }

  .stat-label {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  /* 区域通用 */
  .section-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-8);
  }

  .section-header {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
    flex-wrap: wrap;
  }

  .section-number {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-accent);
    opacity: 0.5;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-text-primary);
    margin: 0;
  }

  .view-all {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .view-all:hover {
    color: var(--color-accent);
  }

  /* 正在阅读 */
  .current-section {
    padding-bottom: var(--space-16);
  }

  .reading-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  .reading-card {
    display: flex;
    gap: var(--space-5);
    padding: var(--space-5);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-xl);
    opacity: 0;
    animation: fadeInUp 0.5s ease forwards;
    animation-delay: var(--delay);
  }

  .book-cover {
    position: relative;
    width: 120px;
    height: 180px;
    flex-shrink: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  .book-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .progress-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: rgba(0, 0, 0, 0.3);
  }

  .progress-bar {
    height: 100%;
    width: var(--progress);
    background: var(--color-accent);
  }

  .book-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-2);
  }

  .book-category {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .book-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-text-primary);
    margin: 0;
    line-height: var(--leading-snug);
  }

  .book-author {
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
    margin: 0;
  }

  .reading-progress {
    margin-top: var(--space-2);
  }

  .progress-text {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }

  /* 书架 */
  .bookshelf-section {
    padding-bottom: var(--space-16);
    background: var(--color-bg-tertiary);
    padding-top: var(--space-12);
    margin: 0 calc(-1 * var(--space-8));
    padding-left: var(--space-8);
    padding-right: var(--space-8);
  }

  .filter-tabs {
    display: flex;
    gap: var(--space-2);
    margin-left: auto;
  }

  .filter-tab {
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-text-tertiary);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: all var(--transition-fast);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .filter-tab:hover,
  .filter-tab.active {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .bookshelf-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--space-5);
  }

  .bookshelf-card {
    padding: var(--space-4);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    transition: all var(--transition-base);
    opacity: 0;
    animation: fadeInUp 0.5s ease forwards;
    animation-delay: var(--delay);
  }

  .bookshelf-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-accent);
  }

  .bookshelf-card .book-cover {
    width: 100%;
    height: 240px;
    margin-bottom: var(--space-4);
  }

  .book-year {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    opacity: 0.6;
  }

  .book-rating {
    display: flex;
    gap: 2px;
    margin-top: var(--space-2);
  }

  .star {
    font-size: var(--text-xs);
    color: var(--color-border);
  }

  .star.filled {
    color: var(--color-accent);
  }

  /* 阅读笔记 */
  .notes-section {
    padding: var(--space-16) 0;
  }

  .notes-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .note-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-5) var(--space-6);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all var(--transition-base);
    opacity: 0;
    animation: fadeInUp 0.5s ease forwards;
    animation-delay: var(--delay);
  }

  .note-card:hover {
    border-color: var(--color-accent);
    transform: translateX(8px);
    box-shadow: var(--shadow-md);
  }

  .note-content {
    flex: 1;
  }

  .note-book {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent);
    opacity: 0.7;
  }

  .note-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-text-primary);
    margin: var(--space-1) 0;
  }

  .note-excerpt {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .note-meta {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .note-date {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }

  .note-arrow {
    color: var(--color-text-tertiary);
    opacity: 0;
    transform: translateX(-10px);
    transition: all var(--transition-fast);
  }

  .note-card:hover .note-arrow {
    opacity: 1;
    transform: translateX(0);
    color: var(--color-accent);
  }

  .view-more {
    text-align: center;
    margin-top: var(--space-8);
  }

  .view-more-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    text-decoration: none;
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-full);
    transition: all var(--transition-fast);
  }

  .view-more-link:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .empty-state {
    text-align: center;
    padding: var(--space-12);
    color: var(--color-text-tertiary);
    font-size: var(--text-sm);
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* 响应式 */
  @media (max-width: 768px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .reading-grid {
      grid-template-columns: 1fr;
    }

    .reading-card {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .bookshelf-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .filter-tabs {
      width: 100%;
      margin-left: 0;
      margin-top: var(--space-4);
    }

    .note-card {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }

    .note-meta {
      width: 100%;
      justify-content: space-between;
    }
  }

  @media (max-width: 480px) {
    .stats-section,
    .section-container {
      padding-left: var(--space-4);
      padding-right: var(--space-4);
    }

    .bookshelf-section {
      margin: 0 calc(-1 * var(--space-4));
      padding-left: var(--space-4);
      padding-right: var(--space-4);
    }
  }
</style>

<script>
  // 书架筛选功能
  const filterTabs = document.querySelectorAll('.filter-tab');
  const bookCards = document.querySelectorAll('.bookshelf-card');

  filterTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const filter = tab.getAttribute('data-filter');

      // 更新激活状态
      filterTabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');

      // 筛选书籍
      bookCards.forEach(card => {
        const category = card.getAttribute('data-category');
        if (filter === 'all' || category === filter) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>
