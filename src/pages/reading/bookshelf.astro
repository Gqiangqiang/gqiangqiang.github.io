---
/**
 * 书架页面
 * 展示所有书籍
 */
import LayoutImmersive from '../../layouts/LayoutImmersive.astro';
import PageHeader from '../../components/PageHeader.astro';
import { siteConfig } from '../../config';
import { getCollection } from 'astro:content';

// 获取所有书籍数据
const allBooks = await getCollection('reading');

// 按出版日期倒序排列
const bookshelf = allBooks
  .sort((a, b) => {
    const dateA = a.data.publishDate?.getTime() || 0;
    const dateB = b.data.publishDate?.getTime() || 0;
    return dateB - dateA;
  })
  .map(book => ({
    id: book.id,
    title: book.data.title,
    author: book.data.author,
    cover: book.data.cover,
    rating: book.data.rating,
    category: book.data.category,
    status: book.data.status,
    progress: book.data.progress,
    year: book.data.publishDate?.getFullYear(),
    translator: book.data.translator,
    publisher: book.data.publisher,
    hasNotes: book.data.hasNotes,
  }));

// 获取所有分类
const categories = [...new Set(bookshelf.map(book => book.category))];
---

<LayoutImmersive title={`书架 · ${siteConfig.name}`} currentPath="/reading/bookshelf">
  <div class="bookshelf-page">
    <PageHeader
      label="Bookshelf"
      title="书架"
      description={`共 ${allBooks.length} 本书`}
    />

    <section class="bookshelf-section">
      <div class="section-container">
        <div class="filter-tabs">
          <button class="filter-tab active" data-filter="all">全部</button>
          {categories.map(category => (
            <button class="filter-tab" data-filter={category}>{category}</button>
          ))}
        </div>
        <div class="bookshelf-grid">
          {bookshelf.map((book, i) => (
            <a href={`/reading/${book.id}`} class="bookshelf-card" style={`--delay: ${i * 80}ms`} data-category={book.category}>
              <div class="book-cover">
                {book.cover ? (
                  <img src={book.cover} alt={book.title} />
                ) : (
                  <div class="cover-placeholder">
                    <span>{book.title.charAt(0)}</span>
                  </div>
                )}
                {book.status === 'reading' && (
                  <div class="status-badge reading">在读</div>
                )}
                {book.status === 'finished' && (
                  <div class="status-badge finished">已读</div>
                )}
              </div>
              <div class="book-info">
                <span class="book-year">{book.year}</span>
                <h3 class="book-title">{book.title}</h3>
                <p class="book-author">{book.author}</p>
                {book.translator && <p class="book-translator">译者: {book.translator}</p>}
                <div class="book-rating">
                  {Array.from({ length: 5 }).map((_, idx) => (
                    <span class:list={['star', { filled: idx < book.rating }]}>★</span>
                  ))}
                </div>
                {book.status === 'reading' && (
                  <div class="reading-progress">
                    <div class="progress-bar" style={`--progress: ${book.progress}%`}></div>
                    <span class="progress-text">{book.progress}%</span>
                  </div>
                )}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </div>
</LayoutImmersive>

<style>
  .bookshelf-page {
    min-height: 100vh;
  }

  .section-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-8);
  }

  .filter-tabs {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
    flex-wrap: wrap;
  }

  .filter-tab {
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-text-tertiary);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: all var(--transition-fast);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .filter-tab:hover,
  .filter-tab.active {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .bookshelf-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--space-5);
  }

  .bookshelf-card {
    display: block;
    padding: var(--space-4);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all var(--transition-base);
    opacity: 0;
    animation: fadeInUp 0.5s ease forwards;
    animation-delay: var(--delay);
  }

  .bookshelf-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-accent);
  }

  .book-cover {
    position: relative;
    width: 100%;
    height: 240px;
    margin-bottom: var(--space-4);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-bg-tertiary);
  }

  .book-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cover-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--color-text-tertiary);
    background: var(--color-bg-tertiary);
  }

  .status-badge {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    padding: var(--space-1) var(--space-2);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    border-radius: var(--radius-sm);
  }

  .status-badge.reading {
    background: var(--color-accent);
    color: white;
  }

  .status-badge.finished {
    background: var(--color-text-tertiary);
    color: white;
  }

  .book-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .book-year {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    opacity: 0.6;
  }

  .book-title {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text-primary);
    margin: 0;
    line-height: var(--leading-snug);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .book-author {
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
    margin: 0;
  }

  .book-translator {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    opacity: 0.7;
    margin: 0;
  }

  .book-rating {
    display: flex;
    gap: 2px;
    margin-top: var(--space-1);
  }

  .star {
    font-size: var(--text-xs);
    color: var(--color-border);
  }

  .star.filled {
    color: var(--color-accent);
  }

  .reading-progress {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .reading-progress .progress-bar {
    flex: 1;
    height: 4px;
    background: var(--color-border);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .reading-progress .progress-bar::after {
    content: '';
    display: block;
    height: 100%;
    width: var(--progress);
    background: var(--color-accent);
  }

  .progress-text {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .bookshelf-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .filter-tabs {
      width: 100%;
    }
  }

  @media (max-width: 480px) {
    .section-container {
      padding-left: var(--space-4);
      padding-right: var(--space-4);
    }
  }
</style>

<script>
  const filterTabs = document.querySelectorAll('.filter-tab');
  const bookCards = document.querySelectorAll('.bookshelf-card');

  filterTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const filter = tab.getAttribute('data-filter');

      filterTabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');

      bookCards.forEach(card => {
        const category = card.getAttribute('data-category');
        if (filter === 'all' || category === filter) {
          (card as HTMLElement).style.display = '';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
